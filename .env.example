# DONMULWON 2 local secrets template
# Copy to .env. NEVER commit .env or share its values in chat.

# Toss Securities Open API OAuth credentials (official names)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Optional account identifier for read-only accounts/holdings endpoints
TOSS_ACCOUNT_SEQ=

# Backward-compatible aliases accepted by this code:
# TOSS_API_KEY= (treated as TOSS_CLIENT_ID)
# TOSS_API_SECRET= (treated as TOSS_CLIENT_SECRET)

# Optional AI analysis provider (not yet connected to the web API)
OPENROUTER_API_KEY=
